<?xml version="1.0" encoding="UTF-8"?>
<!--    
   필요한 3가지 요소 
   appender : 로그 메시지 기록 매체(ConsoleAppender = 콘솔 어펜더= 콘솔에 기록)
   layout : 일정한 형식의 로그를 기록하기 위해. 로그 형식을 포맷으로 결정함. 포맷 자체를 layout이라고 함. 일정한 형식이 아니고 다 다르면 파싱이 안됨
            %d{시간포맷} => 현재 시간 [%thread]=> 쓰레드 풀링.. 쓰레드 돌려막으니까 그거에 대해 쓰레드 뭐인지..  %msg => 실제 기록 메시지
            %로 시작하는 문자 하나하나를 알아야함 => loghome을 통해서 layout에 있는거 읽어서 conversion specifier를 이용해 변경 외우지말고 들가서 docu보고해라!   
   logger : 로그 메시지 기록자
      
      구체적인 로거가 없는 경우 root 로거가 기본으로 사용됨.
      level : 로거가 메시지를 기록할 때 출력 여부를 결정하는 기준
         로거의 종류 trace
                debug
                info
                warn
                error
                fatal
         위에서 아래로 갈수록 강도가 다른거 같음! debug로 메시지 하는건 이건debug용이니까 평소에 안봐도됨! 아래로 갈수록 등급이 높아짐!
         -> 아래로 갈수록 메시디의 등급이 상승하고, 로거에 설정된 lecel과 메시지의 등급이 서로 다르면 출력에서 제외.
         -> 로거의 설정 레벌이 그보다 낮으면 출력에서 제외.
         -> 레벨이 높으면 출력에서 포함됨. -> root는 보통 error로 해두고 그 외의 로거를 통해서 레벨을 조절해주는 것임!
         -> 로거에 설정된 level 보다 기록하는 메시지의 등급이 낮으면 출력에서 제외!
 -->
<configuration debug="false">
	
 <statusListener class="ch.qos.logback.core.status.NopStatusListener"></statusListener>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <!-- encoders are assigned the type
         ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{15} -%kvp- %msg%n</pattern>
    </encoder>
  </appender>
  <appender name="myAppender" class="ch.qos.logback.core.ConsoleAppender">
    <!-- encoders are assigned the type
         ch.qos.logback.classic.encoder.PatternLayoutEncoder by default -->
    <encoder>
      <pattern>%-5level %logger{15} -%kvp- %n----->%msg%n</pattern>
    </encoder>
  </appender>
  <!-- System.out.println 대신 log.info() -->
	<logger name="kr.or.ddit" level="info"/> 
	<logger name="jdbc.sqltiming" level="debug"/>
	<logger name="jdbc.resultsettable" level="info"/>
  <root level="error">
    <appender-ref ref="myAppender" />
  </root>
<typeAliases></typeAliases>
</configuration>